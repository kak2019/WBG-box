.header {
  margin-bottom: 48rpx;
  padding-top: 24rpx;
}

.title {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.5);
}

.game-list {
  margin-bottom: 48rpx;
}

.game-card {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border-left: 8rpx solid #e94560;
}

.game-emoji {
  font-size: 64rpx;
  margin-right: 24rpx;
}

.game-info {
  flex: 1;
}

.game-name {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
}

.game-desc {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
}

.arrow {
  font-size: 48rpx;
  color: rgba(255, 255, 255, 0.3);
}

.leaderboard-btn {
  width: 100%;
}
