<view class="container">
  <view wx:if="{{loading}}" class="center">
    <text>加载中...</text>
  </view>

  <view wx:elif="{{error}}" class="center">
    <text class="error">{{error}}</text>
  </view>

  <view wx:else class="room-card card">
    <block wx:if="{{room}}">
      <text class="game-title">{{room.gameType === 'nonogram' ? '数织' : '扫雷'}} 对战</text>
    <text class="room-id">房间号：{{roomId}}</text>

    <view class="players">
      <view class="player">
        <text class="player-label">房主</text>
        <text class="player-status">{{hostStatus}}</text>
      </view>
      <view class="vs">VS</view>
      <view class="player">
        <text class="player-label">对手</text>
        <text class="player-status">{{guestStatus}}</text>
      </view>
    </view>

    <view class="status-text">
      <text wx:if="{{room.status === 'waiting'}}">等待好友加入，点击下方按钮邀请</text>
      <text wx:elif="{{room.status === 'ready'}}">双方准备后即可开始</text>
    </view>

    <button class="btn-primary" open-type="share">邀请好友</button>
    <button class="btn-secondary ready-btn" bindtap="onReady">我已准备</button>
    </block>
    <view wx:else class="center"><text>连接房间中...</text></view>
  </view>
</view>
