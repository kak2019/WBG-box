.tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 32rpx;
  flex-wrap: wrap;
}

.tab {
  padding: 16rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.6);
}

.tab.active {
  background: #e94560;
  color: #fff;
}

.loading, .empty {
  text-align: center;
  padding: 80rpx 0;
  color: rgba(255, 255, 255, 0.5);
  font-size: 28rpx;
}

.rank-list {
  max-height: calc(100vh - 320rpx);
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.rank-num {
  width: 56rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.4);
}

.rank-num.top {
  color: #ffd700;
}

.rank-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin: 0 20rpx;
  background: rgba(233, 69, 96, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.nickname {
  flex: 1;
  font-size: 28rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.score {
  font-size: 30rpx;
  font-weight: 600;
  color: #e94560;
}

.my-rank {
  position: fixed;
  bottom: 32rpx;
  left: 32rpx;
  right: 32rpx;
  text-align: center;
  font-size: 28rpx;
}
