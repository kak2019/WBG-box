.puzzle-select {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.puzzle-tag {
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.6);
}

.puzzle-tag.active {
  background: #e94560;
  color: #fff;
}

.hud {
  margin-bottom: 24rpx;
  font-size: 28rpx;
}

.board-wrap {
  overflow-x: auto;
  margin-bottom: 32rpx;
}

.clues-top {
  display: flex;
}

.corner {
  width: 80rpx;
  flex-shrink: 0;
}

.col-clues {
  display: flex;
}

.col-clue {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  min-width: 48rpx;
  min-height: 80rpx;
  padding: 4rpx;
}

.board-row {
  display: flex;
}

.row-clues {
  flex-shrink: 0;
}

.row-clue {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  height: 48rpx;
  min-width: 80rpx;
  padding: 4rpx;
  gap: 8rpx;
}

.clue-num {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.2;
}

.grid {
  display: grid;
  gap: 2rpx;
  background: rgba(255, 255, 255, 0.1);
  padding: 2rpx;
}

.cell {
  background: rgba(255, 255, 255, 0.15);
  box-sizing: border-box;
}

.cell.state-1 {
  background: #1a1a2e;
}

.cell.state-2 {
  background: rgba(255, 255, 255, 0.15);
  position: relative;
}

.cell.state-2::after {
  content: '×';
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.4);
  font-size: 24rpx;
}

.actions {
  display: flex;
  gap: 24rpx;
}

.actions button {
  flex: 1;
}
