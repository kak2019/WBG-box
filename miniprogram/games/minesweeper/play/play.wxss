.difficulty-select {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.diff-tag {
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.6);
}

.diff-tag.active {
  background: #0f9b58;
  color: #fff;
}

.hud {
  margin-bottom: 16rpx;
  font-size: 28rpx;
}

.mine-canvas {
  width: 100%;
  height: 700rpx;
  background: #c0c0c0;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.hint {
  text-align: center;
  margin-bottom: 24rpx;
}

.actions {
  display: flex;
  gap: 24rpx;
}

.actions button {
  flex: 1;
}
