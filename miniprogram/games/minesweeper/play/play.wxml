<view class="container">
  <view class="difficulty-select">
    <view
      wx:for="{{difficulties}}"
      wx:key="key"
      class="diff-tag {{difficulty === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onSelectDifficulty"
    >
      {{item.label}}
    </view>
  </view>

  <view class="hud flex-between">
    <text>💣 {{mineCount - flagCount}}</text>
    <text>⏱ {{timeText}}</text>
    <text>🚩 {{flagCount}}</text>
  </view>

  <canvas
    type="2d"
    id="mineCanvas"
    class="mine-canvas"
    bindtouchstart="onTouchStart"
    bindtouchend="onTouchEnd"
  />

  <view class="hint text-muted">点击翻开 · 长按插旗</view>

  <view class="actions">
    <button class="btn-secondary" bindtap="onReset">重新开始</button>
    <button class="btn-primary" bindtap="createBattle">邀请好友对战</button>
  </view>
</view>
