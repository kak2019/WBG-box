.level-select {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.level-tag {
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.6);
}

.level-tag.active {
  background: #f39c12;
  color: #fff;
}

.hud {
  margin-bottom: 24rpx;
  font-size: 28rpx;
}

.board-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}

.board {
  position: relative;
  background: #2a3f5f;
  border-radius: 16rpx;
  overflow: visible;
  border: 4rpx solid rgba(255, 255, 255, 0.15);
}

.grid-bg {
  display: flex;
  flex-wrap: wrap;
  width: 100%;
  height: 100%;
}

.grid-cell {
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.exit-arrow {
  position: absolute;
  right: -48rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 40rpx;
  color: #e94560;
  margin-top: -44rpx;
}

.car {
  position: absolute;
  box-sizing: border-box;
  border-radius: 12rpx;
  border: 3rpx solid rgba(0, 0, 0, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: left 0.15s ease, top 0.15s ease;
  z-index: 2;
}

.car.main-car {
  border-color: rgba(255, 255, 255, 0.5);
  box-shadow: 0 0 16rpx rgba(233, 69, 96, 0.5);
}

.car.selected {
  border-color: #ffd700;
  box-shadow: 0 0 20rpx rgba(255, 215, 0, 0.6);
  z-index: 3;
}

.car-label {
  font-size: 36rpx;
}

.hint-bar {
  background: rgba(243, 156, 18, 0.2);
  border: 1rpx solid rgba(243, 156, 18, 0.4);
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: #f39c12;
  text-align: center;
}

.tip {
  text-align: center;
  margin-bottom: 24rpx;
}

.actions {
  display: flex;
  gap: 24rpx;
}

.actions button {
  flex: 1;
}
